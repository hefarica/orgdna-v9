{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orgdna:platform:policy:2",
  "title": "PolicyDecision - revision 2 del contrato (v2), payload v1 sin cambios",
  "description": "Revision 2 del contrato de politica. Cierra F-T4-2: la exigencia de aprobacion del segundo allOf se limita a los tipos de accion que levantan una puerta obligatoria, y $defs.mandatory_gates pasa de anotacion no referenciada a restriccion evaluable. El motor engine/policy_engine.py NO se modifica: sus decisiones siguen siendo las correctas y eran el contrato el que estaba sobre-restringido.",
  "frozen_by": "docs/PLATAFORMA_CONTRATOS_V1.md",
  "frozen_in_round": "t9 (INT-A)",
  "schema_revision": "2",
  "version_field": "policy_contract_version",
  "payload_version": "1",
  "supersedes": {
    "file": "docs/plataforma/policy.schema.json",
    "schema_revision": "1",
    "sha256": "c6026c70690115c7e37ac0d080510f6f19b36cabc76c89701e7d5443bf54118e",
    "bytes_untouched": true,
    "reason": "Un contrato v1 no se edita en caliente (PLATAFORMA_CONTRATOS_V1.md seccion 10; policy_engine.py:44-45). La revision se emite como archivo nuevo."
  },
  "revision_history": [
    {
      "schema_revision": "1",
      "status": "vigente e intacto",
      "summary": "Contrato de R0. El segundo allOf exige approval objeto en toda decision allow, lo que combinado con gate obligatorio en require_human_approval deja sin salida valida a una accion de solo lectura."
    },
    {
      "schema_revision": "2",
      "status": "esta revision, aditiva",
      "summary": "allow implica aprobacion SOLO para tipos de accion sujetos a puerta obligatoria; los tipos sin puerta se aceptan con gate null y approval null. $defs.mandatory_gates se referencia desde el allOf y desde gate."
    }
  ],
  "compatibility": {
    "engine_unmodified": true,
    "v1_file_bytes_untouched": true,
    "accepts_every_decision_the_engine_produces": true,
    "newly_accepted": "allow con gate null y approval null de tipos de accion sin puerta (F-T4-2)",
    "rejected_that_v1_accepted": "ninguna decision emitida por el motor; el motor ya rechaza allow con gate null y approval no nulo",
    "known_schema_limits": [
      "La igualdad approval.gate == gate no es expresable en JSON Schema; la verifica el motor en validate_decision (policy_engine.py:886-902) y se cubre en las pruebas.",
      "La trazabilidad de matched_rules para allow sin puerta (regla default.open o gate.*) la verifica el motor, no el esquema."
    ]
  },
  "prohibited_fields": [
    "credentials",
    "api_key",
    "api_keys",
    "pending_consent",
    "csrf",
    "cookie",
    "password",
    "access_token",
    "refresh_token",
    "client_secret",
    "private_key",
    "authorization",
    "bearer_token"
  ],
  "prohibited_fields_source": "engine/project_store.py:19 (FORBIDDEN_FIELDS, lista literal reutilizada sin alteracion)",
  "prohibited_fields_rule": "El guard de engine/project_store.py:38-46 compara el nombre normalizado (camelCase->snake_case, '-'->'_' y variante sin caracteres no alfanumericos). Los aprobadores se identifican por rol o referencia opaca, nunca por un valor de credencial.",
  "name_guard": "propertyNames negativo sobre todos los objetos + additionalProperties=false.",
  "inert_by_default": true,
  "inert_by_default_note": "Una decision allow no ejecuta, no firma, no gasta, no abre conectores y no escribe nada: solo declara que la accion propuesta no esta prohibida por la politica vigente. La ejecucion sigue siendo un paso humano o de runtime separado, fuera de este contrato.",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": {
    "not": {
      "pattern": "(?i)(credential|api[_-]?key|access[_-]?token|refresh[_-]?token|bearer[_-]?token|client[_-]?secret|private[_-]?key|password|cookie|csrf|pending[_-]?consent|authorization)"
    }
  },
  "properties": {
    "policy_contract_version": {
      "const": "1",
      "description": "Campo de version del PAYLOAD, no de la revision del contrato: el motor sigue emitiendo \"1\" y no se modifica. La revision del contrato es schema_revision=2."
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
