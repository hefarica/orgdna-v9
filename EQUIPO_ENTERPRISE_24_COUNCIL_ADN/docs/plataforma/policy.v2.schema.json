    "action": {
      "title": "Accion propuesta (declarativa)",
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": {
          "pattern": "(?i)(credential|api[_-]?key|access[_-]?token|refresh[_-]?token|bearer[_-]?token|client[_-]?secret|private[_-]?key|password|cookie|csrf|pending[_-]?consent|authorization)"
        }
      },
      "properties": {
        "action_kind": {
          "enum": [
            "read_repo",
            "write_file",
            "run_tests",
            "call_provider",
            "install_package",
            "open_connector",
            "spend_money",
            "store_memory",
            "push",
            "merge",
            "deploy",
